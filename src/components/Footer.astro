
---
const today = new Date();

const phoneNumber = "498001234567"; // Durch die echte Nummer ersetzen
const displayPhoneNumber = "0172 831 6942"; // Anzeige anpassen
const whatsappNumber = "491728316942"; // Internationale Nummer ohne + oder Leerzeichen
import CookieBanner from './CookieBanner.astro';
---

<footer class="bdry-footer">
  <div class="footer-main">
    <nav class="footer-nav" aria-label="Footer-Navigation">
      <a href="/">Startseite</a>
      <a href="/leistungen/">Leistungen</a>
      <a href="/blog/">Wissenswert</a>
      <a href="/unternehmen/">Unternehmen</a>
      <a href="/kontakt/">Kontakt</a>
    </nav>

    <div class="footer-contact">
      <a
        href={`tel:+${phoneNumber}`}
        class="footer-icon-link"
        aria-label="bdry Schadensservice anrufen"
        title="Anrufen"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.8 19.8 0 0 1 11.19 18a19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.09 3.18 2 2 0 0 1 4.08 1h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.79a2 2 0 0 1-.45 2.11L8.06 8.94a16 16 0 0 0 6 6l1.32-1.27a2 2 0 0 1 2.11-.45c.89.34 1.83.58 2.79.7A2 2 0 0 1 22 16.92Z" />
        </svg>
        <span>{displayPhoneNumber}</span>
      </a>

      <a
        href={`https://wa.me/${whatsappNumber}`}
        class="footer-icon-link"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="bdry Schadensservice auf WhatsApp kontaktieren"
        title="WhatsApp"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.5 3.5A11.8 11.8 0 0 0 12.1 0C5.6 0 .3 5.3.3 11.8c0 2.1.5 4.1 1.6 5.9L0 24l6.5-1.7a11.9 11.9 0 0 0 5.6 1.4h.1c6.5 0 11.8-5.3 11.8-11.8 0-3.2-1.2-6.1-3.5-8.4ZM12.1 21.7a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.9 1 1-3.8-.3-.4a9.8 9.8 0 1 1 8.6 4.8Zm5.4-7.3c-.3-.1-1.6-.8-1.9-.9-.3-.1-.5-.1-.7.2-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1a8 8 0 0 1-2.3-1.4 8.7 8.7 0 0 1-1.6-2c-.2-.3 0-.5.1-.6l.5-.6c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.6l-.9-2.1c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.5s1.1 2.9 1.3 3.1c.2.2 2.2 3.4 5.3 4.7.7.3 1.2.5 1.7.6.7.2 1.3.2 1.8.1.6-.1 1.6-.7 1.8-1.4.2-.7.2-1.3.1-1.4-.1-.2-.3-.3-.6-.4Z" />
        </svg>
        <span>WhatsApp</span>
      </a>
    </div>
  </div>

  <div class="footer-bottom">
    <span>
      &copy; {today.getFullYear()} bdry Schadensservice. Alle Rechte vorbehalten.
    </span>

    <nav class="footer-legal" aria-label="Rechtliche Informationen">
      <a href="/impressum/">Impressum</a>
      <a href="/datenschutz/">Datenschutz</a>
    </nav>
  </div>

  <CookieBanner />

</footer>

<style>
  .bdry-footer {
    padding: 32px 24px 16px;
    background: #f8fafc;
    border-top: 1px solid #e5e7eb;
    color: #5b6472;
    font-family: "Trebuchet MS", Arial, sans-serif;
  }

  .footer-main,
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-main {
    padding-bottom: 28px;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
  }

  .footer-nav a,
  .footer-legal a {
    color: #374151;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-nav a {
    font-size: 0.95rem;
  }

  .footer-nav a:hover,
  .footer-legal a:hover {
    color: #0369a1;
  }

  .footer-contact {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 20px;
    margin-left: auto;
  }

  .footer-icon-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #374151;
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-icon-link:hover {
    color: #0284c7;
  }

  .footer-icon-link svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  .footer-bottom {
    flex-wrap: wrap;
    padding-top: 16px;
    border-top: 1px solid #e5e7eb;
    font-size: 0.75rem;
  }

  .footer-legal {
    display: flex;
    gap: 18px;
  }

  .footer-legal a {
    color: #6b7280;
    font-size: 0.75rem;
  }

  @media (max-width: 850px) {
    .footer-main {
      align-items: flex-start;
      flex-direction: column;
      gap: 22px;
    }

    .footer-contact {
      margin-left: 0;
    }
  }

  @media (max-width: 560px) {
    .bdry-footer {
      padding: 28px 16px 16px;
    }

    .footer-nav {
      gap: 14px 20px;
    }

    .footer-contact {
      flex-wrap: wrap;
      gap: 16px;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
