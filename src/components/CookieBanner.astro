
<div
  id="bdry-cookie-banner"
  class="bdry-cookie-banner"
  role="dialog"
  aria-label="Cookie-Einstellungen"
  aria-describedby="bdry-cookie-description"
  hidden
>
  <div class="bdry-cookie-content">
    <div class="bdry-cookie-text">
      <h2>Ihre Privatsphäre</h2>
      <p id="bdry-cookie-description">
        Wir verwenden technisch notwendige Funktionen, damit diese Website
        zuverlässig funktioniert. Mit Ihrer Zustimmung können wir außerdem
        optionale Dienste verwenden. Sie können Ihre Auswahl jederzeit ändern.
        Weitere Informationen finden Sie in unserer
        <a href="/datenschutz/">Datenschutzerklärung</a>.
      </p>
    </div>

    <div class="bdry-cookie-actions">
      <button
        type="button"
        class="bdry-cookie-button bdry-cookie-necessary"
        data-cookie-choice="necessary"
      >
        Nur notwendige
      </button>

      <button
        type="button"
        class="bdry-cookie-button bdry-cookie-accept"
        data-cookie-choice="all"
      >
        Alle akzeptieren
      </button>
    </div>
  </div>
</div>

<script>
  const banner = document.querySelector<HTMLElement>("#bdry-cookie-banner");

  if (banner) {
    const storageKey = "bdry-cookie-consent";

    try {
      if (!localStorage.getItem(storageKey)) {
        banner.hidden = false;
      }
    } catch {
      // Bei blockiertem localStorage bleibt das Banner sichtbar.
      banner.hidden = false;
    }

    banner.querySelectorAll<HTMLButtonElement>("[data-cookie-choice]")
      .forEach((button) => {
        button.addEventListener("click", () => {
          const choice = button.dataset.cookieChoice;

          try {
            localStorage.setItem(
              storageKey,
              JSON.stringify({
                necessary: true,
                optional: choice === "all",
                date: new Date().toISOString(),
              }),
            );

            banner.hidden = true;
          } catch {
            // Ohne Speichermöglichkeit kann die Auswahl
            // nicht dauerhaft gespeichert werden.
            banner.hidden = true;
          }
        });
      });
  }
</script>

