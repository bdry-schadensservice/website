    justify-content: space-between;
    gap: 28px;
  }

  .bdry-cookie-text {
    flex: 1;
  }

  .bdry-cookie-text h2 {
    margin: 0 0 8px;
    color: #1f2937;
    font-size: 1.15rem;
  }

  .bdry-cookie-text p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .bdry-cookie-text a {
    color: #0284c7;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .bdry-cookie-actions {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    gap: 10px;
    min-width: 165px;
  }

  .bdry-cookie-button {
    min-height: 42px;
    padding: 10px 16px;
    border: 1px solid #0284c7;
