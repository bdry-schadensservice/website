
---
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
  <nav class="nav-container" aria-label="Hauptnavigation">
    <a class="logo-link" href="/" aria-label="Zur Startseite">
      <img src="/logo.png" alt="Firmenlogo" class="site-logo" />
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="main-navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="nav-content" id="main-navigation">
      <div class="nav-links">
        <HeaderLink href="/">Startseite</HeaderLink>
        <HeaderLink href="/leistungen">Leistungen</HeaderLink>
        <HeaderLink href="/unternehmen">Unternehmen</HeaderLink>
		<HeaderLink href="/blog">Wissenswert</HeaderLink>
        <HeaderLink href="/kontakt">Kontakt</HeaderLink>
      </div>
    </div>
  </nav>
</header>

<script>
  const menuToggle = document.querySelector('.menu-toggle');
  const navContent = document.querySelector('.nav-content');

  if (menuToggle && navContent) {
    menuToggle.addEventListener('click', () => {
      const isOpen = navContent.classList.toggle('is-open');

      menuToggle.classList.toggle('is-open', isOpen);
      menuToggle.setAttribute('aria-expanded', String(isOpen));
      menuToggle.setAttribute(
        'aria-label',
        isOpen ? 'Menü schließen' : 'Menü öffnen'
      );
    });

    navContent.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        navContent.classList.remove('is-open');
        menuToggle.classList.remove('is-open');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.setAttribute('aria-label', 'Menü öffnen');
      });
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background: #ffffff;
    border-bottom: 1px solid #e5e7eb;
  }

  .nav-container {
    width: min(1200px, calc(100% - 40px));
    min-height: 88px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .logo-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
  }

  .site-logo {
    display: block;
    width: 62px;
    height: 62px;
    object-fit: contain;
  }

  .nav-content {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-left: auto;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 30px;
  }

  .nav-links :global(a) {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    color: #374151;
    font-family: "Trebuchet MS", Arial, sans-serif;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-links :global(a::after) {
    position: absolute;
    right: 0;
    bottom: 2px;
    left: 0;
    height: 2px;
    background: #0284c7;
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .nav-links :global(a:hover),
  .nav-links :global(a.active),
  .nav-links :global(a[aria-current="page"]) {
    color: #0284c7;
  }

  .nav-links :global(a:hover::after),
  .nav-links :global(a.active::after),
  .nav-links :global(a[aria-current="page"]::after) {
    transform: scaleX(1);
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    padding: 10px;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    background: #ffffff;
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    margin: 4px auto;
    background: #374151;
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .menu-toggle.is-open span:first-child {
    transform: translateY(6px) rotate(45deg);
  }

  .menu-toggle.is-open span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle.is-open span:last-child {
    transform: translateY(-6px) rotate(-45deg);
  }

  .logo-link:focus-visible,
  .menu-toggle:focus-visible,
  .nav-links :global(a:focus-visible) {
    outline: 3px solid #0284c7;
    outline-offset: 4px;
  }

  @media (min-width: 761px) and (max-width: 1000px) {
    .nav-container {
      gap: 24px;
    }

    .nav-links {
      gap: 20px;
    }
  }

  @media (max-width: 760px) {
    .nav-container {
      position: relative;
      width: calc(100% - 32px);
      min-height: 76px;
      gap: 16px;
    }

    .site-logo {
      width: 54px;
      height: 54px;
    }

    .menu-toggle {
      display: block;
      margin-left: auto;
      flex-shrink: 0;
    }

    .nav-content {
      position: absolute;
      top: 100%;
      right: -16px;
      left: -16px;
      display: none;
      align-items: stretch;
      margin-left: 0;
      padding: 12px 16px 20px;
      background: #ffffff;
      border-bottom: 1px solid #e5e7eb;
      box-shadow: 0 10px 18px rgba(0, 0, 0, 0.06);
    }

    .nav-content.is-open {
      display: flex;
      flex-direction: column;
    }

    .nav-links {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .nav-links :global(a) {
      min-height: 48px;
      border-bottom: 1px solid #f3f4f6;
    }

    .nav-links :global(a::after) {
      right: auto;
      bottom: 0;
      width: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-links :global(a),
    .nav-links :global(a::after),
    .menu-toggle span {
      transition: none;
    }
  }
</style>