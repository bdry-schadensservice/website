
---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="de">
  <head>
    <BaseHead
      title={`Wissenswert | ${SITE_TITLE}`}
      description="Fachwissen, Informationen und praktische Hinweise rund um Leckageortung, Wasserschäden und Bautrocknung."
    />

    <style>
      .blog-page {
        --blog-accent: #0284c7;
        --blog-accent-dark: #0369a1;
        --blog-text: #1f2937;
        --blog-muted: #5b6472;
        --blog-border: #e5e7eb;
        --blog-light: #f8fafc;

        width: min(100% - 40px, 1000px);
        margin: 0 auto;
        padding: 64px 0 88px;
        color: var(--blog-text);
        font-family: "Trebuchet MS", Arial, sans-serif;
      }

      .blog-heading {
        margin-bottom: 38px;
      }

      .blog-eyebrow {
        display: inline-block;
        margin-bottom: 12px;
        color: var(--blog-accent-dark);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .blog-heading h1 {
        margin: 0 0 14px;
        font-size: clamp(2rem, 4vw, 2.8rem);
        line-height: 1.2;
        letter-spacing: -0.03em;
      }

      .blog-heading p {
        max-width: 650px;
        margin: 0;
        color: var(--blog-muted);
        font-size: 1.05rem;
        line-height: 1.7;
      }

      .blog-list {
        display: flex;
        flex-direction: column;
        gap: 0;
        margin: 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--blog-border);
      }

      .blog-item {
        margin: 0;
        padding: 24px 0;
        border-bottom: 1px solid var(--blog-border);
      }

      .blog-link {
        display: grid;
        grid-template-columns: 200px minmax(0, 1fr);
        align-items: center;
        gap: 28px;
        color: inherit;
        text-decoration: none;
      }

      .blog-image {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 10;
        overflow: hidden;
        border-radius: 8px;
        background: var(--blog-light);
      }

      .blog-image img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.25s ease;
      }

      .blog-content {
        min-width: 0;
      }

      .blog-title {
        margin: 0 0 10px;
        color: var(--blog-text);
        font-size: 1.3rem;
        line-height: 1.4;
        transition: color 0.2s ease;
      }

      .blog-description {
        display: -webkit-box;
        overflow: hidden;
        margin: 0;
        color: var(--blog-muted);
        font-size: 0.97rem;
        line-height: 1.7;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
      }

      .blog-read-more {
        display: inline-block;
        margin-top: 12px;
        color: var(--blog-accent-dark);
        font-size: 0.9rem;
        font-weight: 700;
      }

      .blog-link:hover .blog-title {
        color: var(--blog-accent-dark);
      }

      .blog-link:hover .blog-image img {
        transform: scale(1.04);
      }

      .blog-empty {
        padding: 28px 0;
        color: var(--blog-muted);
      }

      @media (max-width: 600px) {
        .blog-page {
          width: calc(100% - 32px);
          padding: 44px 0 64px;
        }

        .blog-heading {
          margin-bottom: 26px;
        }

        .blog-item {
          padding: 20px 0;
        }

        .blog-link {
          grid-template-columns: 112px minmax(0, 1fr);
          align-items: start;
          gap: 16px;
        }

        .blog-title {
          margin-bottom: 6px;
          font-size: 1.05rem;
        }

        .blog-description {
          font-size: 0.9rem;
          line-height: 1.5;
          -webkit-line-clamp: 3;
        }

        .blog-read-more {
          margin-top: 8px;
          font-size: 0.85rem;
        }
      }

      @media (max-width: 380px) {
        .blog-link {
          grid-template-columns: 90px minmax(0, 1fr);
          gap: 12px;
        }

        .blog-title {
          font-size: 0.98rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .blog-image img,
        .blog-title {
          transition: none;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <main class="blog-page">
      <header class="blog-heading">
        <span class="blog-eyebrow">Wissen &amp; Informationen</span>
        <h1>Wissenswert</h1>
        <p>
          Fachwissen, hilfreiche Informationen und praktische Hinweise
          rund um Leckageortung, Wasserschäden und Bautrocknung.
        </p>
      </header>

      {posts.length > 0 ? (
        <ul class="blog-list">
          {posts.map((post) => (
            <li class="blog-item">
              <a class="blog-link" href={`/blog/${post.id}/`}>
                <div class="blog-image">
                  {post.data.heroImage && (
                    <Image
                      src={post.data.heroImage}
                      alt={post.data.title}
                      width={400}
                      height={250}
                      loading="lazy"
                    />
                  )}
                </div>

                <div class="blog-content">
                  <h2 class="blog-title">{post.data.title}</h2>

                  <p class="blog-description">
                    {post.data.description}
                  </p>

                  <span class="blog-read-more">
                    Weiterlesen →
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="blog-empty">
          Aktuell sind noch keine Beiträge verfügbar.
        </p>
      )}
    </main>

    <Footer />
  </body>
</html>
