
---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="de">
  <head>
    <BaseHead
      title={`Unsere Leistungen | ${SITE_TITLE}`}
      description="Leckortung, technische Bautrocknung, Schadensservice und Schimmelpilzsanierung von bdry Schadensservice."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body>
    <Header />

    <main class="services-page">
      <section class="services-hero">
        <div class="services-container">
          <span class="services-eyebrow">Unsere Leistungen</span>
          <h1>Professionelle Hilfe bei Wasser- und Feuchtigkeitsschäden</h1>
          <p>
            Von der punktgenauen Leckortung über die technische Bautrocknung
            bis zur vollständigen Schadensdokumentation: Wir unterstützen Sie
            mit moderner Messtechnik und persönlicher Betreuung.
          </p>
          <a class="services-button" href="/kontakt/">
            Kontakt aufnehmen
          </a>
        </div>
      </section>

      <section class="services-list" aria-label="Unsere Leistungsbereiche">
        <div class="services-container">

          <!-- 1. Leckortung -->
          <article class="service-item" id="leckortung">
            <div class="service-icon" aria-hidden="true">
              <svg viewBox="0 0 48 48" fill="none">
                <path
                  d="M24 5C19 13 11 21 11 29a13 13 0 0 0 26 0C37 21 29 13 24 5Z"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linejoin="round"
                />
                <path
                  d="M18 30a6 6 0 0 0 6 6"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                />
                <circle
                  cx="34"
                  cy="13"
                  r="7"
                  fill="#e0f2fe"
                  stroke="currentColor"
                  stroke-width="2"
                />
                <path
                  d="m39 18 4 4"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                />
              </svg>
            </div>

            <div class="service-content">
              <span class="service-number">01</span>
              <h2>Zerstörungsfreie Leckortung</h2>
              <p class="service-intro">
                Verborgene Wasseraustritte in Wänden, unter dem Estrich oder
                in der Fußbodenheizung verursachen oft erhebliche
                Folgeschäden. Wir lokalisieren die Leckage punktgenau, um
                Aufstemmaßnahmen auf ein absolutes Minimum zu reduzieren.
              </p>

              <h3>Eingesetzte Verfahren</h3>
              <ul class="service-features">
                <li>
                  <span aria-hidden="true">✓</span>
                  <div>
                    <strong>Thermografie: </strong>
                    Sichtbarmachen von Temperaturunterschieden an
                    wasserführenden Leitungen.
                  </div>
                </li>
                <li>
                  <span aria-hidden="true">✓</span>
                  <div>
                    <strong>Elektroakustik: </strong>
                    Hörbarmachen von Fließgeräuschen unter Druck.
                  </div>
                </li>
                <li>
                  <span aria-hidden="true">✓</span>
                  <div>
                    <strong>Formiergasverfahren: </strong>
                    Auffinden kleinster Risse durch unschädliches Spurengas.
                  </div>
                </li>
                <li>
                  <span aria-hidden="true">✓</span>
                  <div>
                    <strong>Endoskopie &amp; Feuchtigkeitsmessung: </strong>
                    Zerstörungsarme Untersuchung von Hohlräumen und
                    Dämmschichten.
                  </div>
                </li>
                <li>
                  <span aria-hidden="true">✓</span>
                  <div>
                    <strong>Druckprüfungen: </strong>
                    Feststellung von Druckverlusten zur Eingrenzung undichter Leitungen.
                  </div>
                </li>
              </ul>

              <a class="service-link" href="/blog/leckortung">
                Details zur Leckortung <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>

          <!-- 2. Bautrocknung -->
          <article class="service-item" id="bautrocknung">
            <div class="service-icon" aria-hidden="true">
              <svg viewBox="0 0 48 48" fill="none">
                <rect
                  x="7"
                  y="6"
                  width="34"
                  height="36"
                  rx="4"
                  stroke="currentColor"
                  stroke-width="2.2"
                />
                <path
                  d="M13 13h22M13 18h22"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                />
                <path
                  d="M16 25c-2 2-2 4 0 6s2 4 0 6M24 25c-2 2-2 4 0 6s2 4 0 6M32 25c-2 2-2 4 0 6s2 4 0 6"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                />
              </svg>
            </div>

            <div class="service-content">
              <span class="service-number">02</span>
              <h2>Technische Bautrocknung</h2>
              <p class="service-intro">
                Nach Behebung der Ursache muss dem Baukörper die eingedrungene
                Feuchtigkeit fachgerecht entzogen werden. Unsere modernen
                Trocknungsgeräte unterstützen die kontrollierte Trocknung
                und helfen, Folgeschäden durch Restfeuchte zu vermeiden.
              </p>

              <h3>Einsatzbereiche &amp; Technik</h3>
              <ul class="service-features">
                <li>
                  <span aria-hidden="true">✓</span>
                  <div>
                    <strong>Estrich-Dämmschichttrocknung: </strong>
                    Trocknung durch Vakuum- oder Überdruckverfahren.
                  </div>
                </li>
                <li>
                  <span aria-hidden="true">✓</span>
                  <div>
                    <strong>Kondensations- &amp; Adsorptionstrockner: </strong>
                    Effiziente Entfeuchtung von Raumluft und Mauerwerk.
                  </div>
                </li>
                <li>
                  <span aria-hidden="true">✓</span>
                  <div>
                    <strong>Infrarot-Wandtrocknung: </strong>
                    Zielgerichtete Erwärmung feuchter Wandabschnitte.
                  </div>
                </li>
                <li>
                  <span aria-hidden="true">✓</span>
                  <div>
                    <strong>Messwertkontrolle: </strong>
                    Fortlaufende Messung bis zur verlässlichen
                    Ausgleichsfeuchte.
                  </div>
                </li>
                <li>
                  <span aria-hidden="true">✓</span>
                  <div>
                    <strong>Luftumwälzung mittels Lüftern: </strong>
                    Verbesserte Luftzirkulation für eine gleichmäßige und effiziente Trocknung.
                  </div>
                </li>
                
              </ul>

              <a class="service-link" href="/blog/bautrocknung">
                Details zur Bautrocknung <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>

          <!-- 3. Schadensservice -->
          <article class="service-item" id="schadensservice">
            <div class="service-icon" aria-hidden="true">
              <svg viewBox="0 0 48 48" fill="none">
                <path
                  d="M13 5h16l8 8v30H13V5Z"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linejoin="round"
                />
                <path
                  d="M29 5v9h8M19 23h12M19 29h12M19 35h8"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                />
                <circle
                  cx="35"
                  cy="35"
                  r="8"
                  fill="#e0f2fe"
                  stroke="currentColor"
                  stroke-width="2"
                />
                <path
                  d="m31.5 35 2.3 2.3 4-4.6"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>

            <div class="service-content">
              <span class="service-number">03</span>
              <h2>Schadensservice &amp; Versicherungsabwicklung</h2>
              <p class="service-intro">
                Wir reduzieren Ihren organisatorischen Aufwand im Schadensfall.
                Wir dokumentieren alle Messwerte und Maßnahmen lückenlos für
                Ihre Versicherung.
              </p>

              <h3>Ihr Vorteil beim Service</h3>
              <ul class="service-features">
                <li>
                  <span aria-hidden="true">✓</span>
                  <div>
                    <strong>Versicherungsfertige Messberichte: </strong>
                    Aussagekräftige Bild- und Messdokumentation.
                  </div>
                </li>
                <li>
                  <span aria-hidden="true">✓</span>
                  <div>
                    <strong>Transparente Abrechnung: </strong> Nachvollziehbare Positionen für Regulierungspartner.
                  </div>
                </li>
                <li>
                  <span aria-hidden="true">✓</span>
                  <div>
                    <strong>Persönliche Beratung: </strong>
                    Direkte Kommunikation ohne Zwischeninstanzen.
                  </div>
                </li>
              </ul>

              <a class="service-link" href="/blog/schadensservice">
                Details zum Schadensservice <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>

          <!-- 4. Schimmelpilzsanierung -->
          <article class="service-item" id="schimmel">
            <div class="service-icon" aria-hidden="true">
              <svg viewBox="0 0 48 48" fill="none">
                <path
                  d="M24 5v38M5 24h38M10.5 10.5l27 27M37.5 10.5l-27 27"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                />
                <circle
                  cx="24"
                  cy="24"
                  r="7"
                  fill="#e0f2fe"
                  stroke="currentColor"
                  stroke-width="2"
                />
                <circle cx="24" cy="12" r="3" fill="currentColor" />
                <circle cx="24" cy="36" r="3" fill="currentColor" />
                <circle cx="12" cy="24" r="3" fill="currentColor" />
                <circle cx="36" cy="24" r="3" fill="currentColor" />
              </svg>
            </div>

            <div class="service-content">
              <span class="service-number">04</span>
              <h2>Schimmelpilzsanierung &amp; Prävention</h2>
              <p class="service-intro">
                Erhöhte Restfeuchte nach Wasserschäden kann Schimmelpilzwachstum
                begünstigen. Wir ermitteln die Ursachen, beurteilen betroffene
                Bereiche und unterstützen mit geeigneten Sanierungs- und
                Präventionsmaßnahmen.
              </p>

              <h3>Leistungsumfang &amp; Bautenschutz</h3>
              <ul class="service-features">
                <li>
                  <span aria-hidden="true">✓</span>
                  <div>
                    <strong>Ursachenanalyse &amp; Befallsmessung: </strong>
                    Bestimmung der Feuchtequellen und betroffenen Flächen.
                  </div>
                </li>
                <li>
                  <span aria-hidden="true">✓</span>
                  <div>
                    <strong>Fachgerechte Beseitigung: </strong>
                    Sanierungsmaßnahmen nach den einschlägigen fachlichen
                    Standards.
                  </div>
                </li>
                <li>
                  <span aria-hidden="true">✓</span>
                  <div>
                    <strong>Sporenbeseitigung &amp; Raumluftreinigung: </strong>
                    Einsatz geeigneter Filter- und Reinigungssysteme.
                  </div>
                </li>
                <li>
                  <span aria-hidden="true">✓</span>
                  <div>
                    <strong>Präventive Maßnahmen: </strong>
                    Unterstützung dabei, erneuter Schimmelbildung vorzubeugen.
                  </div>
                </li>
              </ul>

              <a class="service-link" href="/blog/schimmel">
                Details zu Schimmel &amp; Prävention
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>

        </div>
      </section>

      <!-- Kontakt-CTA -->
      <section class="services-cta" id="kontakt">
        <div class="services-cta-inner">
          <span class="services-eyebrow">Wir helfen Ihnen weiter</span>
          <h2>Akuter Feuchtigkeitsschaden oder Ortungsbedarf?</h2>
          <p>
            Nehmen Sie direkt Kontakt mit uns auf. Wir beraten Sie persönlich
            und besprechen mit Ihnen die nächsten notwendigen Schritte.
          </p>
          <a class="services-button" href="/kontakt/">
            Jetzt Anfrage senden
          </a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .services-page {
    color: #374151;
    font-family: "Trebuchet MS", Arial, sans-serif;
  }

  .services-container {
    width: min(1120px, calc(100% - 48px));
    margin: 0 auto;
  }

  .services-hero {
    padding: 76px 0 72px;
    background: #f8fafc;
    border-bottom: 1px solid #e5e7eb;
  }

  .services-hero .services-container {
    max-width: 900px;
  }

  .services-eyebrow {
    display: inline-block;
    margin-bottom: 14px;
    color: #0284c7;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .services-hero h1 {
    max-width: 850px;
    margin: 0 0 22px;
    color: #1f2937;
    font-size: clamp(2.1rem, 5vw, 3.4rem);
    line-height: 1.15;
  }

  .services-hero p,
  .services-cta p {
    max-width: 760px;
    margin: 0 0 28px;
    color: #4b5563;
    font-size: 1.08rem;
    line-height: 1.8;
  }

  .services-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 13px 22px;
    border: 1px solid #0284c7;
    border-radius: 6px;
    background: #0284c7;
    color: #ffffff;
    font-size: 0.96rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .services-button:hover {
    background: #0369a1;
    border-color: #0369a1;
  }

  .services-list {
    padding: 28px 0 80px;
    background: #ffffff;
  }

  .service-item {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 30px;
    padding: 52px 0;
    border-bottom: 1px solid #e5e7eb;
    scroll-margin-top: 100px;
  }

  .service-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 12px;
    background: #f0f9ff;
    color: #0284c7;
  }

  .service-icon svg {
    width: 42px;
    height: 42px;
  }

  .service-content {
    max-width: 850px;
  }

  .service-number {
    display: block;
    margin-bottom: 8px;
    color: #0284c7;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .service-content h2 {
    margin: 0 0 18px;
    color: #1f2937;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.3;
  }

  .service-intro {
    margin: 0 0 28px;
    color: #4b5563;
    font-size: 1rem;
    line-height: 1.85;
  }

  .service-content h3 {
    margin: 0 0 16px;
    color: #1f2937;
    font-size: 1.08rem;
  }

  .service-features {
    display: grid;
    gap: 15px;
    margin: 0 0 28px;
    padding: 0;
    list-style: none;
  }

  .service-features li {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    align-items: start;
    gap: 10px;
    color: #4b5563;
    font-size: 0.97rem;
    line-height: 1.75;
  }

  .service-features li > span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    margin-top: 2px;
    border-radius: 50%;
    background: #e0f2fe;
    color: #0369a1;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .service-features strong {
    color: #374151;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #0284c7;
    font-size: 0.96rem;
    font-weight: 700;
    text-decoration: none;
  }

  .service-link:hover {
    color: #0369a1;
  }

  .service-link span {
    transition: transform 0.2s ease;
  }

  .service-link:hover span {
    transform: translateX(4px);
  }

  .services-cta {
    padding: 76px 24px;
    background: #f0f9ff;
    text-align: center;
  }

  .services-cta-inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .services-cta h2 {
    margin: 0 0 18px;
    color: #1f2937;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    line-height: 1.25;
  }

  .services-cta p {
    margin-right: auto;
    margin-left: auto;
  }

  @media (max-width: 700px) {
    .services-container {
      width: min(100% - 40px, 560px);
    }

    .services-hero {
      padding: 56px 0;
    }

    .services-list {
      padding: 8px 0 56px;
    }

    .service-item {
      grid-template-columns: 1fr;
      gap: 22px;
      padding: 36px 0;
    }

    .service-icon {
      width: 60px;
      height: 60px;
    }

    .service-icon svg {
      width: 36px;
      height: 36px;
    }

    .services-cta {
      padding: 56px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .services-button,
    .service-link span {
      transition: none;
    }
  }
</style>
